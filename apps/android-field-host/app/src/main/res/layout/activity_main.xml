<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="#0B0E14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📡  UpDesk Field"
            android:textColor="#F1F5F9"
            android:textSize="24sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tagline"
            android:textColor="#8A97A8"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp" />

        <!-- ID + fixed password card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#141A24"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#232C3B"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR ID (fixed)"
                    android:textColor="#6B7A8D"
                    android:textSize="11sp"
                    android:letterSpacing="0.15" />

                <TextView
                    android:id="@+id/myId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#F1F5F9"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginTop="2dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#232C3B"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PASSWORD (fixed — connect anytime)"
                    android:textColor="#6B7A8D"
                    android:textSize="11sp"
                    android:letterSpacing="0.15" />

                <EditText
                    android:id="@+id/password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#4ADE80"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:inputType="textVisiblePassword"
                    android:fontFamily="monospace"
                    android:autofillHints=""
                    android:layout_marginTop="2dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/savePwBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Save"
                        android:textColor="#9DB2C9" />

                    <Button
                        android:id="@+id/newPwBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New password"
                        android:textColor="#9DB2C9"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Give the ID + password to the control room. They stay the same forever."
                    android:textColor="#6B7A8D"
                    android:textSize="12sp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Go online (24/7) -->
        <Button
            android:id="@+id/goOnlineBtn"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/go_online"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#16A34A"
            app:cornerRadius="14dp"
            android:layout_marginTop="18dp" />

        <Button
            android:id="@+id/stopBtn"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stop (go offline)"
            android:textAllCaps="false"
            android:layout_marginTop="8dp" />

        <!-- Status -->
        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/offline"
            android:textColor="#8A97A8"
            android:textSize="13sp"
            android:gravity="center"
            android:padding="10dp"
            android:layout_marginTop="12dp" />

        <!-- Reliability section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STAY ONLINE 24/7"
            android:textColor="#6B7A8D"
            android:textSize="11sp"
            android:letterSpacing="0.15"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/batteryBtn"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disable battery optimization"
            android:textAllCaps="false"
            android:gravity="start|center_vertical" />

        <Button
            android:id="@+id/overlayBtn"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Allow display over other apps"
            android:textAllCaps="false"
            android:gravity="start|center_vertical"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="For nonstop operation: disable battery optimization above, allow location 'all the time', and on Xiaomi/Oppo/Vivo/Samsung enable Autostart for this app in the system settings."
            android:textColor="#6B7A8D"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginTop="10dp" />

    </LinearLayout>
</ScrollView>
